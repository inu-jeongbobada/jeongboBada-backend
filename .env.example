# 이 파일을 복사해서 .env로 저장한 뒤, 필요하면 값을 바꿔서 사용한다.
#   cp .env.example .env
# .env 자체는 비밀번호가 들어갈 수 있으므로 .gitignore 대상 (커밋 금지).
# 값을 비워두거나 .env가 없어도 docker-compose.yml의 기본값(${VAR:-default})으로 동작한다.

MYSQL_DATABASE=jeongbobada
MYSQL_USER=jeongbobada
MYSQL_PASSWORD=jeongbobada
MYSQL_ROOT_PASSWORD=root

# JWT 서명 키. MySQL 값과 달리 기본값이 없다 — docker-compose로 backend까지 띄울 거라면
# 아래에 직접 랜덤 값(HS256 기준 32바이트 이상)을 채워 넣어야 한다.
JWT_SECRET=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# 비밀번호 찾기 / 이메일 변경 인증코드를 보낼 SMTP 계정. 비워두면 backend는 뜨지만 메일 발송만 실패한다.
# Gmail: MAIL_PASSWORD에는 계정 비밀번호가 아니라 "앱 비밀번호"(2단계 인증 켠 뒤 발급)를 넣는다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 파일 업로드(S3). 비워두면 docker-compose.yml의 기본값(us-east-1, jeongbobada-dev)을 쓴다.
AWS_REGION=
AWS_S3_BUCKET=
# S3 자격 증명. 비워두면 backend는 뜨지만 업로드만 실패한다.
# Learner Lab은 세션마다 새 임시 키가 나오니 AWS Details에서 세 값을 매번 다시 복사한다.
# 실제 학생 서류를 올리지 말 것 (docs/file-upload-architecture.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# 브라우저에서 API를 호출할 수 있게 허용하는 프론트 origin. 비워두면 docker-compose.yml의 기본값
# (localhost:5173 + 배포 도메인)을 쓴다. 프론트 배포 도메인이 바뀌면 여기를 갱신한다.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=
