# 이 파일을 복사해서 application.yml로 저장한 뒤, 아래 값을 채워서 사용한다.
# application.yml 자체는 비밀번호가 들어가므로 .gitignore 대상 (커밋 금지).
#   cp src/main/resources/application.yml.example src/main/resources/application.yml
spring:
  application:
    name: jeongbobada
  datasource:
    # docker-compose.yml로 띄운 MySQL 기본값. docker-compose.yml의 환경변수를 바꿨다면 여기도 맞춰야 한다.
    url: jdbc:mysql://localhost:3306/jeongbobada
    username:
    password:
  jpa:
    hibernate:
      # update: 엔티티 변경사항을 기동 시 테이블에 자동 반영 (개발 편의용, 운영에서는 지양)
      ddl-auto: update
    # data.sql이 Hibernate의 테이블 생성/수정보다 먼저 실행돼버리는 걸 막음 (기본값은 false)
    defer-datasource-initialization: true
  sql:
    init:
      # MySQL 같은 외부 DB는 기본적으로 data.sql을 자동 실행하지 않아서 always로 강제 실행
      mode: always

# JWT 서명 키. DB 비밀번호와 달리 팀원끼리 값을 맞출 필요 없음 (각자 로컬 서버 안에서만 쓰이는 값).
# HS256 기준 최소 256비트(32바이트) 이상의 값을 넣어야 한다.
jwt:
  secret:
  expiration: 3600000 # 1시간 (ms 단위)
